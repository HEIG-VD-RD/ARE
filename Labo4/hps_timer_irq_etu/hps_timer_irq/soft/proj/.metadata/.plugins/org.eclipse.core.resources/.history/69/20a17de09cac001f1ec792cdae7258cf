void direction_init(uint32_t *direction, uint32_t mask, DIRECTION dir_value)
{
	if (dir_value == IN) {
		// Set the direction IN for the keys, switches...
	        *direction &= ~mask;
	} else {
		// Set the direction OUT for the LEDS, HEX....
	        *direction |= mask;
	}
}

//***********************************//
//****** Global usage function ******//

uint32_t Switchs_read(void)
{
    volatile uint32_t *currentState = PIO0_DATA;
    uint32_t switches_state = (*currentState & SWITCHES_MASK) >> SWITCHS_OFFSET;

    return switches_state;
}

void Leds_write(uint32_t value)
{
    volatile uint32_t *ledsValue = PIO0_DATA;
    if (value > 0x3FF)
    {
        printf("Error: value is too big\n");
        return;
    }
    uint32_t current_state = *ledsValue;
    current_state &= (~(0x3FF << LEDS_OFFSET));
    *ledsValue = current_state | (value << LEDS_OFFSET);
}

void Leds_set(uint32_t maskleds)
{
    volatile uint32_t *ledsValue = PIO0_OUTSET;
	
    if (maskleds > 0x3ff)
    {
        printf("Error: maskleds is too big\n");
        return;
    }
    *ledsValue |= (maskleds << LEDS_OFFSET);
}

void Leds_clear(uint32_t maskleds)
{
    volatile uint32_t *ledsValue = PIO0_OUTCLEAR;
    if (maskleds > 0x3ff)
    {
        printf("Error: maskleds is too big\n");
        return;
    }

    *ledsValue |= (maskleds << LEDS_OFFSET);
}

void Leds_toggle(uint32_t maskleds)
{
    volatile uint32_t *ledsValue = PIO0_DATA;

    uint32_t current_state = (*ledsValue >> LEDS_OFFSET) & LEDS_MASK;
    // xor op to toggle only the leds we want
    uint32_t toggled_value = current_state ^ maskleds;
    Leds_write(toggled_value);
}

bool Key_read(int key_number)
{
	volatile uint32_t *dataValue = PIO0_DATA;
	// Get the key number and check its value
	uint32_t keyValue = ((*dataValue  >> KEYS_OFFSET) >> key_number)& 0x1;
	return (keyValue == 0 ? true : false);
}

void Seg7_write(int seg7_number, uint32_t value)
{

	uint32_t maskSeg;
	volatile uint32_t *dataRegister = PIO1_DATA;
	switch(seg7_number){
	case 0:
		maskSeg = HEX_0;
		break;
	case 1:
		maskSeg = HEX_1;
		value =value << 7;
		break;
	case 2:
		maskSeg = HEX_2;
		value = value << 14;
		break;
	case 3:
		maskSeg = HEX_3;
		value = value << 21;
		break;
	default:
		printf("Wrong number. It should be between [0:3] and not %d\n");
		return;
	}

	// Operation to write one hex segment and not erase the others
	*dataRegister &= ~maskSeg;
	*dataRegister |= (~value & maskSeg );

}

void Seg7_write_hex(int seg7_number, uint32_t value)
{

	if(value > HEX_MAX){
		printf("Value not accepted. It shoud be bewteen [0x0:0xf] and not %d\n", value);
		return;
	}
	// Use of the precedent function and the array to write an hexa value
	Seg7_write(seg7_number,hexValue[value] );
}

uint32_t Read_hex(int seg7_number)
{
	volatile uint32_t *dataRegister = PIO1_DATA;
	uint32_t value;
	switch (seg7_number){
	case 0:
		return *dataRegister & HEX_0;
	case 1:
		return (*dataRegister & HEX_1) >> 7;
	case 2:
		// not operation used since low state to get the "normal" value
		value = (~(*dataRegister) & HEX_2) >> 14;

		//Return i which is the number in the array of the value compared
	    for (int i = 0; i < 16; i++) {
	        if (hexValue[i] == value) {
	            return i;
	        }
	    }
		break;
	case 3:
		// not operation used since low state to get the "normal" value
		value = (~(*dataRegister) & HEX_3) >> 21;
		return value;
	default:
		printf("Wrong number. It should be between [0:3]\n");
		return -1;
	}
}
