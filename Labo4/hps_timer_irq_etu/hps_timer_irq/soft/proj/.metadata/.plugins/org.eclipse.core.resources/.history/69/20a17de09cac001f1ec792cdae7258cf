//****** Init function ******//
void Switchs_init(void)
{
    volatile uint32_t *switchDirection = PIO0_DIRECTION;
    direction_init(switchDirection, SWITCHES_MASK << SWITCHS_OFFSET , IN);
}

void Leds_init(void)
{
	uint8_t shift = LEDS_OFFSET;
    volatile uint32_t *ledsDirection = PIO0_DIRECTION;
    direction_init(ledsDirection, LEDS_MASK << shift, OUT );
    Leds_set(0x0);

}

void Keys_init(void)
{
    volatile uint32_t *keyDirection = PIO0_DIRECTION;
    direction_init(keyDirection, KEY_MASK << KEYS_OFFSET, IN);
}

