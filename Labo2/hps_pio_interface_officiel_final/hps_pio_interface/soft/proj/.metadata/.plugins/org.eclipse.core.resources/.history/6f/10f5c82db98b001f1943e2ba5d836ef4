uint32_t Switchs_read(void)
{
    volatile uint32_t *currentState = PIO0_DATA;
    uint32_t switches_state = (*currentState & SWITCHES_MASK) >> 4;

    return switches_state;
}

void Leds_write(uint32_t value)
{
    volatile uint32_t *ledsValue = PIO0_DATA;
    if (value > 0x3FF)
    {
        printf("Error: value is too big\n");
        return;
    }
    uint32_t current_state = ledsValue;

    current_state &= ~(0x3FF << 16);

    ledsValue = current_state | (value << 16);
}

void Leds_set(uint32_t maskleds)
{
    volatile uint32_t *ledsValue = PIO0_OUTSET;
	
    if (maskleds > 0x3ff)
    {
        printf("Error: maskleds is too big\n");
        return;
    }
    *ledsValue |= (maskleds << 16);
}

void Leds_clear(uint32_t maskleds)
{
    volatile uint32_t *ledsValue = PIO0_OUTCLEAR;
    if (maskleds > 0x3ff)
    {
        printf("Error: maskleds is too big\n");
        return;
    }

    *ledsValue |= (maskleds << 16);
}

