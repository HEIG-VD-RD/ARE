bool Key_read(int key_number)
{
	volatile uint32_t *dataValue = PIO0_DATA;
	uint32_t keyValue = (*dataValue >> key_number) & 0x1;

	return (keyValue == 0 ? true : false);
}

void Seg7_write(int seg7_number, uint32_t value)
{

	uint32_t maskSeg;
	volatile uint32_t *dataRegister = PIO1_DATA;
	switch(seg7_number){
	case 0:
		maskSeg = HEX_0;
		break;
	case 1:
		maskSeg = HEX_1;
		value =value << 7;
		break;
	case 2:
		maskSeg = HEX_2;
		value = value << 14;
		break;
	case 3:
		maskSeg = HEX_3;
		value = value << 21;
		break;
	default:
		printf("Wrong number. It should be between [0:3]\n");
		return;
	}
	*dataRegister &= ~maskSeg;
	*dataRegister |= (~value & maskSeg );

}

void Seg7_write_hex(int seg7_number, uint32_t value)
{

	if(value > HEX_MAX){
		printf("Value not accepted. It shoud be bewteen [0x0:0xf] \n");
		return;
	}

	Seg7_write(seg7_number,hexValue[value] );
}

uint32_t read_hex(int seg7_number)
{
	volatile uint32_t *dataRegister = PIO1_DATA;
	switch (seg7_number){
	case 0:
		return *dataRegister & HEX_0;
	case 1:
		return *dataRegister & HEX_1;
	case 2:
		return (~(*dataRegister) & HEX_2) >> 14;
	case 3:
		return *dataRegister & HEX_3;
	default:
		printf("Wrong number. It should be between [0:3]\n");
	return -1;
	}
}

