#include <stdint.h>
#include <stdbool.h>
#include <stdio.h>
#include "axi_lw.h"
#include "pio_function.h"


int __auto_semihosting;

# define NUM_KEYS 4

int main(void){

	printf("Laboratoire: Programme simple avec E/S du HPS \n");

	volatile uint32_t *constante = (volatile uint32_t *) CONSTANTE_BASE;
	printf("Constante ID : 0x%x \n", *constante);
	// Initialize all peripherals
	Leds_init();
	Segs7_init();
	Switchs_init();
	Keys_init();

	// Arrays used to check rising edges of keys
	bool previousState[NUM_KEYS] = {false, false, false, false};
	while(true){
		uint32_t valueSeg2 = Read_hex(2);
		uint32_t valueSeg3 = Read_hex(3);
		uint32_t valueSwitch = Switchs_read();

		bool currentState[NUM_KEYS] = {false, false, false, false};


		for (int i = 0; i < NUM_KEYS; i++) {
			currentState[i] = Key_read(i);
		}

		if(currentState[0] && !previousState[0]){
			uint32_t valueSeg89 = (valueSwitch & SWITCH_9_8) >> 8;

			switch(valueSeg89){
				case 0:
					Leds_write(valueSwitch & SWITCH_7_0);
					break;
				case 1:
					Leds_set(valueSwitch & SWITCH_7_0);
					break;
				case 2:
					Leds_clear(valueSwitch & SWITCH_7_0);
					break;
				case 3:
					Leds_toggle(LEDS_7_0);
					break;
				default:
					printf("Erreur de numéro\n ");
			}

		}

		// Read switches and write the hexa value on 7-segments 0 and 1
		if(currentState[1] && !previousState[1]){
			uint32_t valueH0 = valueSwitch & SWITCH_3_0;
			uint32_t valueH1 = (valueSwitch & SWITCH_7_4) >> 4;
			Seg7_write_hex(0,valueH0);
			Seg7_write_hex(1,valueH1);
		}
		// Increment the value showed on the
		if(currentState[2] && !previousState[2]){

			valueSeg2 = (valueSeg2 + 1) % 16;
			Seg7_write_hex(2,valueSeg2);

		}
		if(currentState[3] && !previousState[3]){

			valueSeg3 = valueSeg3 == 0x20 ? 0x1 : valueSeg3 << 1;
			Seg7_write(3,valueSeg3);
		}

		for (int i = 0; i < NUM_KEYS; i++) {
			previousState[i] = currentState[i];

		}
	}
}


